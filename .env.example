DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DEFAULT_FROM_EMAIL=noreply@example.com
PASSWORD_RESET_CONFIRM_URL=http://localhost:3000/reset-password?uid={uid}&token={token}
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10

# Stage 2 market data
FMP_API_KEY=
FMP_BASE_URL=https://financialmodelingprep.com/stable
MARKET_DATA_HTTP_TIMEOUT=10
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_CONNECT_TIMEOUT=2
REDIS_SOCKET_TIMEOUT=2
MARKET_SEARCH_TTL=300
MARKET_SEARCH_STALE_TTL=86400
MARKET_QUOTE_TTL=60
MARKET_QUOTE_STALE_TTL=86400
MARKET_PROFILE_TTL=86400
MARKET_PROFILE_STALE_TTL=604800
MARKET_DIVIDENDS_TTL=21600
MARKET_DIVIDENDS_STALE_TTL=604800
MARKET_NEGATIVE_TTL=120

# Stage 2 brokerage provider
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# Optional read-only live verification user; never commit real values.
SNAPTRADE_TEST_USER_ID=
SNAPTRADE_TEST_USER_SECRET=
